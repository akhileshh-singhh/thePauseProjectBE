DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Preferred: PostgreSQL URL (example: postgresql://user:pass@host:5432/dbname)
DATABASE_URL=
# Set false for local Postgres without SSL, true for hosted Postgres (Render/Neon/etc.)
DB_SSL_REQUIRE=true

# Set USE_SQLITE=true only for quick local dev
USE_SQLITE=false

# Fallback MySQL settings (used only when DATABASE_URL is empty and USE_SQLITE=false)
MYSQL_DATABASE=pause_project
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
